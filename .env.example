# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=restai
POSTGRES_PASSWORD=change-me-in-production

# ── API Server ────────────────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Detrás de un proxy inverso (Traefik, Nginx, Cloudflare), ponlo en "true" para
# que el rate-limit y la auditoría lean la IP real de X-Forwarded-For.
# ATENCIÓN: déjalo en "false" si la API queda expuesta directamente a internet;
# de lo contrario cualquiera puede falsear su IP con una cabecera y saltarse el
# límite de peticiones.
TRUST_PROXY=false

# ── Límites de peticiones ─────────────────────────────────────────────
# Los topes por defecto (200/min global, 150/min comensal, 20/min login) están
# pensados para un local lleno: TODO el restaurante comparte una sola IP pública,
# así que un tope bajo hace que el personal y los comensales se bloqueen entre sí
# justo en hora punta. Las peticiones autenticadas NO se cuentan por IP sino por
# identidad, con un tope mayor (RATE_LIMIT_USER_FACTOR veces el anónimo).
# Ajusta solo si un local grande topa:
# RATE_LIMIT_GLOBAL_ANON_MAX=200
# RATE_LIMIT_GLOBAL_USER_MAX=600
# RATE_LIMIT_CUSTOMER_ANON_MAX=150
# RATE_LIMIT_USER_FACTOR=3
#
# LOCALES CON TABLETS DE PARED: estos dos cubos se cuentan por IP (son públicos,
# aún no hay token) y todas las tablets del local salen por la MISMA IP pública.
# Los topes por defecto —5 sesiones y 20 búsquedas de mesa cada 10 minutos— dan
# de sobra para comensales entrando con su móvil, pero se agotan enseguida si
# hay varias tablets abriendo sesiones. Súbelos en proporción al número de
# tablets (una tablet activa ≈ una sesión por comensal que se sienta):
# RATE_LIMIT_SESSION_CREATE_ANON_MAX=40
# RATE_LIMIT_TABLE_BY_CODE_ANON_MAX=120

# ── Database (composed automatically in docker-compose) ───────────────
# Only needed when running outside Docker:
# DATABASE_URL=postgresql://restai:change-me-in-production@localhost:5432/restai
# Driver de DB (portabilidad sin tocar código):
#   postgres-js (default) = TCP clásico (contenedor / Postgres local)
#   neon                  = driver serverless de Neon (HTTP/WebSocket)
# Si no se define, se autodetecta: una URL *.neon.tech usa "neon".
# DATABASE_DRIVER=postgres-js

# ── Redis (hardcoded in docker-compose as redis://redis:6379) ─────────
# Only needed when running outside Docker:
# REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 Storage ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=restai
R2_PUBLIC_URL=

# ── Realtime (mensajería en vivo) ────────────────────────────────────
# Proveedor: websocket (default, WS de Bun + Redis) | pusher | ably | noop
REALTIME_PROVIDER=websocket
# Pusher (si REALTIME_PROVIDER=pusher):
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Ably (si REALTIME_PROVIDER=ably): API key con formato appId.keyId:keySecret
ABLY_API_KEY=
# Coordinador del WebSocket propio: local | redis
#   local = un solo proceso (desarrollo, VPS de una instancia)
#   redis = varias instancias detrás de un balanceador. IMPRESCINDIBLE al escalar:
#           cada conexión queda fijada a una instancia, y sin Redis pub/sub la
#           cocina no vería los pedidos que entraron por otra instancia.
REALTIME_WS_COORDINATOR=local

# ── Correo transaccional y de marketing (Resend) ─────────────────────
# Sin RESEND_API_KEY el sistema NO envía correos y lo registra en notification_log
# como "skipped": el registro de clientes, los códigos de acceso, los avisos de
# puntos por vencer y las campañas quedan silenciosamente sin entregar.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Mi Restaurante <hola@mirestaurante.pe>"
RESEND_FROM=

# ── Mesero por voz ───────────────────────────────────────────────────
# Dos proveedores soportados. Sin ninguna clave la función queda apagada:
# /api/voice/config devuelve enabled:false, la tablet no ofrece el botón de
# hablar y la carta táctil sigue funcionando igual. Las claves NUNCA bajan al
# navegador: el backend acuña una credencial efímera por sesión de mesa.
#
#   openai → API Realtime, transporte WebRTC (audio a cargo del navegador)
#   gemini → Live API, transporte WebSocket con PCM (lo maneja nuestro código)
#
# Si se omite, se autodetecta por la clave disponible (OpenAI primero). Un valor
# mal escrito APAGA la voz en vez de caer a otro proveedor con otro precio.
VOICE_AGENT_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Interruptor manual: ponlo en "false" para apagar la voz sin quitar las claves.
VOICE_AGENT_ENABLED=true

# ATENCIÓN: modelo y voz son DEL PROVEEDOR ACTIVO. Si cambias de proveedor,
# cámbialos también o bórralos para que se usen los valores por defecto de cada
# uno; un modelo de OpenAI declarado con gemini activo rompe la conexión.
#   openai → modelo gpt-realtime-2.1-mini (por defecto), voces marin, cedar, alloy…
#   gemini → modelo gemini-3.1-flash-live-preview (por defecto), voces Puck, Charon, Kore…
# VOICE_AGENT_MODEL=
# VOICE_AGENT_VOICE=

# Tope de minutos de conversación por sesión de mesa. Es el freno de gasto: una
# tablet olvidada con el micro abierto factura toda la noche. Al superarlo, la
# tablet cae a la carta táctil sin romperse.
VOICE_AGENT_MAX_MINUTES_PER_SESSION=15

# ── SUNAT (Facturación Electrónica) ──────────────────────────────────
# Clave para cifrar en reposo las credenciales SOL y el certificado digital.
# Usa una cadena aleatoria de 32+ caracteres. Generar: openssl rand -hex 32
SUNAT_ENCRYPTION_KEY=change-me-32-chars-random-string
# El emisor (RUC, certificado, credenciales SOL, ambiente beta/production) se
# configura por organización vía PUT /api/sunat/config y se guarda cifrado en BD.

# ── Web App (build-time — set as Build Variable in Coolify) ──────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# URL pública de la aplicación. Se imprime en el cartel de cada mesa: es la que
# teclea el comensal que NO puede escanear el QR ({APP_URL}/{sede}/codigo).
# Si está mal, el plan B de la carta digital no funciona.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Port mapping (optional) ──────────────────────────────────────────
WEB_PORT=3000
