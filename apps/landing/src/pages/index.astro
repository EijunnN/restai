---
/*
  Landing de RestAI.

  Rehecha siguiendo el marco de decisión de animación de Emil Kowalski. Las
  reglas no se versionan aquí (son de terceros); se instalan con
  `npx skills@latest add emilkowalski/skills`. Tres decisiones cargan con todo:

  1. SIN GSAP. La versión anterior enviaba 116 KB de JavaScript para unos
     fundidos y un parallax. Aquí todo lo hace CSS y un IntersectionObserver de
     quince líneas. No es solo peso: las animaciones CSS corren fuera del hilo
     principal, así que siguen fluidas mientras la página carga — justo cuando
     un JS de animación pierde fotogramas. El publico de esta pagina abre desde
     un movil con 4G.

  2. LA VERDAD NO DEPENDE DE UNA ANIMACIÓN. Las cifras se renderizaban a "0" y
     solo subían con un contador al hacer scroll: quien pedía menos movimiento,
     quien tenía el JS caído y CUALQUIER RASTREADOR leían "0 canales de venta" y
     "0 % comprobantes listos para SUNAT" — lo contrario de lo que la página
     quiere decir. Ahora el número está en el HTML y no se anima: son datos que
     se leen, y los datos que se leen no se mueven por estética.

  3. UNA SOLA ANIMACIÓN LARGA, Y EXPLICA ALGO. El marco permite duraciones
     largas en marketing solo cuando la animación EXPLICA. Esa es la secuencia
     del héroe: QR → comanda en cocina → boleta. Todo lo demás es entrada
     discreta. Fuera la flotación infinita (coste perpetuo de batería sin
     propósito) y el parallax por scroll (decoración que salta en móvil).
*/
const SITE = "https://restai.bezenti.com";
const APP_URL = "https://app.restai.bezenti.com";
const API_HEALTH = "https://api.restai.bezenti.com/health";
const OG_IMAGE = `${SITE}/og.png`;
const DESC =
  "Sistema de gestión para restaurantes: punto de venta, comandas a cocina en tiempo real, carta por QR, pedidos por voz y facturación electrónica SUNAT. Multi-sede, en español.";

/* Los tres momentos del servicio que la secuencia del héroe representa. */
const secuencia = [
  { clave: "qr", titulo: "El comensal pide", detalle: "Escanea el QR de su mesa" },
  { clave: "cocina", titulo: "La cocina lo ve", detalle: "La comanda entra en el pase" },
  { clave: "boleta", titulo: "Se cobra y se declara", detalle: "Boleta electrónica a SUNAT" },
];

/*
  Cifras COMPROBABLES. Las anteriores eran de relleno —"−Horas", "+Clientes",
  "∞ sucursales"— y una cifra que nadie puede verificar no convence: resta.
*/
const cifras = [
  { valor: "3", etiqueta: "canales en la misma pantalla", nota: "mesa · mostrador · reparto" },
  { valor: "5", etiqueta: "roles con permisos propios", nota: "dueño, gerente, cajero, mozo, cocina" },
  { valor: "IGV", etiqueta: "y comprobantes ante SUNAT", nota: "boleta, factura y nota de crédito" },
];

const pasos = [
  {
    n: "01",
    titulo: "El comensal escanea el QR de su mesa",
    desc: "Abre la carta en su propio teléfono. Puede pedir desde ahí, o solo mirar: tú decides si la carta es interactiva o solo de lectura.",
  },
  {
    n: "02",
    titulo: "La cocina la recibe en el acto",
    desc: "La comanda aparece en el pase, con el tiempo que lleva esperando cada plato. Si algo se acaba, se anula desde ahí y todos se enteran.",
  },
  {
    n: "03",
    titulo: "El salón cobra sin buscar la cuenta",
    desc: "Las cuentas abiertas del local están en una lista, ordenadas por lo que necesita algo de ti. Cobrar es un toque.",
  },
  {
    n: "04",
    titulo: "El comprobante sale solo",
    desc: "Boleta o factura electrónica firmada y declarada ante SUNAT, sin salir del cobro ni volver a teclear nada.",
  },
];

/*
  Seis bloques, no doce tarjetas con emoji. Doce tarjetas iguales no se leen: se
  hojean, y el que hojea no distingue lo que este producto tiene de distinto.
*/
const bloques = [
  {
    titulo: "El comensal pide hablando",
    destacado: true,
    desc: "Un agente de voz atiende al comensal en su mesa: le dice qué hay, resuelve dudas y arma el pedido conversando. Lo cierra hablando, no tocando la pantalla.",
    puntos: ["Carta digital por QR", "Interactiva o solo lectura", "Llamar al mozo y pedir la cuenta"],
  },
  {
    titulo: "El punto de venta",
    desc: "Todas las cuentas abiertas del local en una lista que cabe entera. El botón grande cambia según el tipo: en salón manda a cocina, en mostrador cobra.",
    puntos: ["Mesa, mostrador y reparto", "Ampliar una cuenta con otra ronda", "Cobro rápido o dividido por producto"],
  },
  {
    titulo: "La cocina y el salón",
    desc: "El pase en tiempo real, y un plano del local que dibujas como es de verdad: juntar mesas, mover una visita, ver quién lleva más rato esperando.",
    puntos: ["Tablero del pase en vivo", "Plano de sala editable", "Avisos de mesa persistentes"],
  },
  {
    titulo: "El dinero",
    desc: "Cobros por orden o por producto, propinas, anulaciones con rastro, y arqueo de caja al cerrar el turno con la diferencia calculada.",
    puntos: ["Efectivo, tarjeta, Yape, Plin", "Arqueo por turno", "Facturación electrónica SUNAT"],
  },
  {
    titulo: "La carta",
    desc: "Categorías y platos que ordenas arrastrando, opciones con lo que el plato lleva de serie ya marcado, y el ranking real de lo que más se vende.",
    puntos: ["Opciones y modificadores", "Agotar un plato desde cocina", "Los más vendidos, con cifras"],
  },
  {
    titulo: "El negocio",
    desc: "Inventario que se descuenta solo con cada venta, fidelización con puntos, cupones, campañas y reportes del día a día.",
    puntos: ["Multi-sede bajo una cuenta", "Permisos por rol y por sede", "Auditoría de quién cambió qué"],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#org`,
      name: "RestAI",
      url: SITE,
      logo: `${SITE}/og.svg`,
      description: DESC,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "RestAI",
      publisher: { "@id": `${SITE}/#org` },
      inLanguage: "es",
    },
    {
      "@type": "SoftwareApplication",
      name: "RestAI",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      url: SITE,
      description: DESC,
      /*
        SIN bloque `offers`. El anterior declaraba `price: "0"` mientras la
        pagina no dice una palabra de precio: Google publicaba "gratis" en los
        resultados y el visitante llegaba sin saberlo. Declarar un precio falso
        es peor que no declarar ninguno; cuando haya tarifa publica, vuelve.
      */
      featureList: bloques.map((b) => b.titulo),
    },
  ],
};
---

<!doctype html>
<!--
  `sin-js` viaja en el HTML y el script en linea la quita. Es lo que garantiza
  que sin JavaScript la pagina se vea: los elementos que animan nacen con
  `opacity: 0`, y si nada les quitara esa opacidad quedaria una pagina en blanco.
  Al reves —anadir una clase `js`— el contenido parpadearia de visible a oculto.
-->
<html lang="es" class="sin-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={SITE} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0b0f17" />
    <meta name="generator" content={Astro.generator} />

    <title>RestAI — Sistema de gestión para restaurantes</title>
    <meta name="description" content={DESC} />
    <meta
      name="keywords"
      content="software para restaurantes, POS restaurante, comandas en tiempo real, carta QR, pedido por voz, facturación electrónica SUNAT, sistema multisucursal, punto de venta, gestión de restaurante Perú"
    />
    <meta name="author" content="RestAI" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RestAI" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={SITE} />
    <meta property="og:title" content="RestAI — Sistema de gestión para restaurantes" />
    <meta property="og:description" content={DESC} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RestAI — Sistema de gestión para restaurantes" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="RestAI — Sistema de gestión para restaurantes" />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%BD%EF%B8%8F%3C/text%3E%3C/svg%3E"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <header class="nav" id="nav">
      <a class="brand" href="/"><span aria-hidden="true">🍽️</span> RestAI</a>
      <nav class="nav-links" aria-label="Principal">
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#producto">Qué hace</a>
      </nav>
      <a class="btn btn-primary" href={APP_URL}>Ingresar al panel</a>
    </header>

    <main>
      <!-- ── HÉROE ─────────────────────────────────────────────────────── -->
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow entra">Para restaurantes del Perú</p>
            <h1 class="entra">
              El pedido llega a cocina<br />
              <span class="grad">antes de que el mozo se dé la vuelta.</span>
            </h1>
            <p class="lead entra">
              Punto de venta, comandas en vivo, carta por QR —y un agente de voz que
              toma el pedido hablando—. Con la boleta declarada ante SUNAT sin teclear
              nada dos veces.
            </p>
            <div class="cta entra">
              <a class="btn btn-primary btn-lg" href={APP_URL}>Ingresar al panel</a>
              <a class="btn btn-ghost btn-lg" href="#como-funciona">Ver cómo funciona</a>
            </div>
          </div>

          <!--
            La ÚNICA animación larga de la página, y existe porque explica: el
            recorrido de un pedido, de la mesa a SUNAT. Se reproduce una vez al
            llegar; no vuelve a moverse. Una animación de héroe en bucle cobra
            batería para siempre a cambio de nada.
          -->
          <div class="demo" aria-hidden="true">
            <div class="demo-linea"></div>

            <figure class="paso paso-qr">
              <div class="tarjeta">
                <div class="qr"></div>
                <p class="tarjeta-pie">Mesa 4 · escanea y pide</p>
              </div>
            </figure>

            <figure class="paso paso-cocina">
              <div class="tarjeta">
                <p class="tarjeta-tit"><span class="punto"></span> Comanda · Mesa 4</p>
                <p class="linea"><span>2× Lomo saltado</span><span class="chip">En cocina</span></p>
                <p class="linea"><span>1× Ceviche</span><span class="chip chip-espera">4 min</span></p>
                <p class="linea"><span>3× Chicha morada</span><span class="chip chip-ok">Listo</span></p>
              </div>
            </figure>

            <figure class="paso paso-boleta">
              <div class="tarjeta">
                <p class="tarjeta-tit">Boleta electrónica</p>
                <p class="total">S/ 128.00</p>
                <p class="tarjeta-pie ok">Aceptada por SUNAT</p>
              </div>
            </figure>
          </div>
        </div>

        <!--
          Las cifras están en el HTML y NO se animan. Antes se renderizaban a
          "0" y solo subían con un contador al hacer scroll: quien pedía menos
          movimiento, quien no ejecutaba el JS y los rastreadores leían
          "0 canales de venta". Un dato que se lee no se mueve por estética.
        -->
        <dl class="cifras entra">
          {cifras.map((c) => (
            <div class="cifra">
              <dt class="cifra-valor grad">{c.valor}</dt>
              <dd class="cifra-etiqueta">
                {c.etiqueta}
                <span class="cifra-nota">{c.nota}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- ── CÓMO FUNCIONA ─────────────────────────────────────────────── -->
      <section id="como-funciona" class="seccion">
        <header class="seccion-cabecera revela">
          <p class="kicker">Cómo funciona</p>
          <h2>De la mesa al comprobante, sin papel por el medio</h2>
        </header>
        <ol class="pasos">
          {pasos.map((p) => (
            <li class="paso-fila revela">
              <span class="paso-n">{p.n}</span>
              <div>
                <h3>{p.titulo}</h3>
                <p>{p.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── QUÉ HACE ──────────────────────────────────────────────────── -->
      <section id="producto" class="seccion">
        <header class="seccion-cabecera revela">
          <p class="kicker">Qué hace</p>
          <h2>Un sistema, no doce módulos sueltos</h2>
          <p class="seccion-sub">
            Todo comparte los mismos datos: lo que cambia la cocina lo ve la caja, y lo
            que cobra la caja lo ve el dueño.
          </p>
        </header>

        <div class="bloques">
          {bloques.map((b) => (
            <article class={b.destacado ? "bloque bloque-destacado revela" : "bloque revela"}>
              {b.destacado && <p class="insignia">Lo que no tiene nadie más</p>}
              <h3>{b.titulo}</h3>
              <p>{b.desc}</p>
              <ul class="puntos">
                {b.puntos.map((punto) => (
                  <li>{punto}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- ── CIERRE ────────────────────────────────────────────────────── -->
      <section class="cierre revela">
        <h2>Tu local, ordenado <span class="grad">desde el primer servicio.</span></h2>
        <p>Entra al panel y monta tu carta, tus mesas y tu equipo en una tarde.</p>
        <a class="btn btn-primary btn-lg" href={APP_URL}>Ingresar al panel</a>
      </section>
    </main>

    <footer class="pie">
      <div class="pie-marca"><span aria-hidden="true">🍽️</span> RestAI</div>
      <nav class="pie-enlaces" aria-label="Pie">
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#producto">Qué hace</a>
        <a href={APP_URL}>Panel</a>
        <a href={API_HEALTH}>Estado del servicio</a>
      </nav>
      <span>© {new Date().getFullYear()} RestAI</span>
    </footer>

    <style is:global>
      :root {
        --bg: #0b0f17;
        --bg-suave: #111827;
        --bg-tarjeta: #141b2b;
        --fg: #e9edf5;
        --tenue: #98a3b8;
        --acento: #ff7849;
        --acento-2: #ffb347;
        --borde: #1f2937;
        --radio: 1rem;
        --max: 1120px;

        /*
          Curvas propias. Las de serie de CSS son flojas: les falta el empuje que
          hace que un movimiento parezca intencionado y no un desvanecimiento.
          `ease-in` no aparece en ninguna parte a propósito — empieza lento justo
          en el instante que el ojo más mira, y hace sentir lenta la interfaz.
        */
        --sale: cubic-bezier(0.23, 1, 0.32, 1);
        --entra-sale: cubic-bezier(0.77, 0, 0.175, 1);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 { line-height: 1.15; letter-spacing: -0.025em; font-weight: 750; }
      a { color: inherit; text-decoration: none; }
      .grad {
        background: linear-gradient(100deg, var(--acento), var(--acento-2));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      /* ── Botones ──────────────────────────────────────────────────────
         `:active` con escala es la regla que más se nota y la que más se
         olvida: sin ella el botón no confirma que la interfaz oyó el toque.
         El hover va tras `hover: hover` porque en una pantalla táctil el
         navegador dispara hovers falsos al tocar, y el botón se queda
         "iluminado" después de soltarlo. */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.7rem 1.2rem;
        border-radius: 0.7rem;
        font-weight: 650;
        font-size: 0.95rem;
        border: 1px solid transparent;
        cursor: pointer;
        transition: transform 140ms var(--sale), background-color 140ms var(--sale),
          border-color 140ms var(--sale);
      }
      .btn:active { transform: scale(0.97); }
      .btn-lg { padding: 0.9rem 1.5rem; font-size: 1rem; }
      .btn-primary { background: var(--acento); color: #180a04; }
      .btn-ghost { border-color: var(--borde); color: var(--fg); }
      @media (hover: hover) and (pointer: fine) {
        .btn-primary:hover { background: #ff8d63; }
        .btn-ghost:hover { border-color: #33415a; background: rgba(255, 255, 255, 0.03); }
      }
      .btn:focus-visible { outline: 2px solid var(--acento-2); outline-offset: 2px; }

      /* ── Cabecera ─────────────────────────────────────────────────── */
      .nav {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        max-width: var(--max);
        margin: 0 auto;
        padding: 0.9rem 1.25rem;
        background: rgba(11, 15, 23, 0.75);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid transparent;
        transition: border-color 200ms var(--sale);
      }
      .nav.posado { border-bottom-color: var(--borde); }
      .brand { font-weight: 750; letter-spacing: -0.02em; }
      .nav-links { display: flex; gap: 1.4rem; margin-left: auto; font-size: 0.92rem; color: var(--tenue); }
      /*
        En movil se encogen, no desaparecen. Antes eran `display: none` sin
        menu que los sustituyera: la mitad de la navegacion dejaba de existir
        justo en el dispositivo desde el que se lee esta pagina.
      */
      @media (max-width: 720px) {
        .nav { gap: 0.9rem; padding: 0.75rem 1rem; }
        .nav-links { gap: 0.9rem; font-size: 0.82rem; }
      }
      @media (max-width: 420px) { .nav-links { display: none; } }
      @media (hover: hover) and (pointer: fine) { .nav-links a:hover { color: var(--fg); } }

      /* ── Estructura ───────────────────────────────────────────────── */
      main { max-width: var(--max); margin: 0 auto; padding: 0 1.25rem; }
      .seccion { padding: 5.5rem 0; }
      .seccion-cabecera { max-width: 46rem; margin-bottom: 2.5rem; }
      .kicker {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.74rem;
        color: var(--acento-2);
        margin: 0 0 0.7rem;
      }
      .seccion-cabecera h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin: 0; }
      .seccion-sub { color: var(--tenue); margin: 0.9rem 0 0; font-size: 1.02rem; }

      /* ── Héroe ────────────────────────────────────────────────────── */
      .hero { padding: 4rem 0 1rem; }
      .hero-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 3rem;
        align-items: center;
      }
      @media (max-width: 940px) {
        .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      }
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.78rem;
        color: var(--acento-2);
        margin: 0 0 1rem;
      }
      .hero h1 { font-size: clamp(2.1rem, 5.6vw, 3.5rem); margin: 0 0 1.2rem; }
      .lead { color: var(--tenue); font-size: 1.1rem; max-width: 52ch; margin: 0 0 2rem; }
      .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }

      /* ── La secuencia explicativa ─────────────────────────────────── */
      .demo { position: relative; display: grid; gap: 0.9rem; }
      .demo-linea {
        position: absolute;
        left: 1.4rem;
        top: 1.5rem;
        bottom: 1.5rem;
        width: 2px;
        background: linear-gradient(var(--acento), transparent);
        transform-origin: top;
        opacity: 0.35;
      }
      .paso { margin: 0; }
      .tarjeta {
        background: var(--bg-tarjeta);
        border: 1px solid var(--borde);
        border-radius: var(--radio);
        padding: 1rem 1.15rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
      }
      .paso-qr .tarjeta { max-width: 13rem; }
      .paso-cocina { margin-left: 2.5rem; }
      .paso-boleta { margin-left: 5rem; max-width: 15rem; }

      .tarjeta-tit { font-weight: 650; font-size: 0.9rem; margin: 0 0 0.7rem; display: flex; align-items: center; gap: 0.45rem; }
      .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--acento); }
      .linea { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; font-size: 0.82rem; color: var(--tenue); margin: 0; padding: 0.3rem 0; }
      .chip { font-size: 0.68rem; padding: 0.12rem 0.5rem; border-radius: 999px; background: #20283a; color: var(--tenue); white-space: nowrap; }
      .chip-ok { background: rgba(74, 222, 128, 0.14); color: #6ee7a8; }
      .chip-espera { background: rgba(255, 179, 71, 0.16); color: var(--acento-2); }
      .qr {
        width: 5rem;
        height: 5rem;
        margin: 0 auto 0.6rem;
        border-radius: 0.5rem;
        background: repeating-conic-gradient(#e9edf5 0 90deg, #141b2b 0 180deg);
        background-size: 20px 20px;
        outline: 6px solid #e9edf5;
        outline-offset: -6px;
      }
      .tarjeta-pie { font-size: 0.78rem; color: var(--tenue); margin: 0; text-align: center; }
      .tarjeta-pie.ok { color: #6ee7a8; text-align: left; }
      .total { font-size: 1.5rem; font-weight: 750; margin: 0.2rem 0 0.3rem; letter-spacing: -0.03em; }

      /* ── Cifras ───────────────────────────────────────────────────── */
      .cifras {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin: 4rem 0 0;
        padding: 1.6rem;
        background: var(--bg-suave);
        border: 1px solid var(--borde);
        border-radius: var(--radio);
      }
      @media (max-width: 720px) { .cifras { grid-template-columns: 1fr; gap: 1.4rem; } }
      .cifra { margin: 0; }
      .cifra-valor { font-size: clamp(1.7rem, 3.5vw, 2.2rem); font-weight: 780; letter-spacing: -0.03em; }
      .cifra-etiqueta { margin: 0.2rem 0 0; color: var(--fg); font-size: 0.92rem; }
      .cifra-nota { display: block; color: var(--tenue); font-size: 0.82rem; margin-top: 0.15rem; }

      /* ── Pasos ────────────────────────────────────────────────────── */
      .pasos { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
      .paso-fila {
        display: grid;
        grid-template-columns: 3rem 1fr;
        gap: 1rem;
        align-items: start;
        padding: 1.4rem 1.5rem;
        background: var(--bg-suave);
        border: 1px solid var(--borde);
        border-radius: var(--radio);
      }
      .paso-n { font-weight: 800; font-size: 1rem; color: var(--acento); font-variant-numeric: tabular-nums; }
      .paso-fila h3 { font-size: 1.08rem; margin: 0 0 0.35rem; }
      .paso-fila p { margin: 0; color: var(--tenue); font-size: 0.95rem; }

      /* ── Bloques de producto ──────────────────────────────────────── */
      .bloques { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1rem; }
      .bloque {
        background: var(--bg-tarjeta);
        border: 1px solid var(--borde);
        border-radius: var(--radio);
        padding: 1.6rem;
        transition: transform 180ms var(--sale), border-color 180ms var(--sale);
      }
      @media (hover: hover) and (pointer: fine) {
        .bloque:hover { transform: translateY(-2px); border-color: #2b3a52; }
      }
      .bloque-destacado {
        grid-column: 1 / -1;
        background: linear-gradient(140deg, rgba(255, 120, 73, 0.09), var(--bg-tarjeta) 60%);
        border-color: rgba(255, 120, 73, 0.28);
      }
      .insignia {
        display: inline-block;
        margin: 0 0 0.7rem;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        background: rgba(255, 120, 73, 0.16);
        color: var(--acento-2);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .bloque h3 { font-size: 1.2rem; margin: 0 0 0.5rem; }
      .bloque > p { margin: 0; color: var(--tenue); font-size: 0.96rem; }
      .bloque-destacado > p { max-width: 46ch; font-size: 1.02rem; }
      .puntos { list-style: none; padding: 0; margin: 1.1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
      .puntos li {
        font-size: 0.82rem;
        color: var(--tenue);
        padding: 0.25rem 0.65rem;
        border: 1px solid var(--borde);
        border-radius: 999px;
      }

      /* ── Cierre ───────────────────────────────────────────────────── */
      .cierre {
        text-align: center;
        background: linear-gradient(135deg, rgba(255, 120, 73, 0.12), rgba(255, 179, 71, 0.06));
        border: 1px solid var(--borde);
        border-radius: 1.4rem;
        padding: 4rem 1.5rem;
        margin: 1rem 0 4rem;
      }
      .cierre h2 { font-size: clamp(1.8rem, 4.5vw, 2.6rem); margin: 0 0 0.6rem; }
      .cierre p { color: var(--tenue); margin: 0 0 1.8rem; }

      /* ── Pie ──────────────────────────────────────────────────────── */
      .pie {
        max-width: var(--max);
        margin: 0 auto;
        padding: 2.2rem 1.25rem 3.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        border-top: 1px solid var(--borde);
        color: var(--tenue);
        font-size: 0.9rem;
      }
      .pie-marca { font-weight: 700; color: var(--fg); }
      .pie-enlaces { display: flex; gap: 1.3rem; margin: 0 auto; flex-wrap: wrap; }
      @media (hover: hover) and (pointer: fine) { .pie-enlaces a:hover { color: var(--fg); } }

      /* ══ MOVIMIENTO ═══════════════════════════════════════════════════
         Todo con `transform` y `opacity`, las dos únicas propiedades que se
         saltan el cálculo de posición y el pintado y corren en la GPU. Animar
         `top`, `height` o `margin` dispara las tres etapas en cada fotograma.

         Y todo con CSS, no con JavaScript: una animación CSS sigue fluida
         mientras la página carga y ejecuta scripts, que es exactamente cuando
         una animación por JavaScript pierde fotogramas. Aquí eso importa más
         que en ningún sitio — quien abre esta página lo hace desde un móvil.

         El desplazamiento es de 10–14px, no de 26: un elemento que aparece
         desde muy lejos parece que venía de fuera de la pantalla, y a la
         tercera sección cansa. */

      .entra,
      .revela { will-change: transform, opacity; }

      /* Entrada del héroe: se ve una vez, al llegar. */
      .entra {
        opacity: 0;
        transform: translateY(12px);
        animation: aparecer 480ms var(--sale) forwards;
      }
      /* Escalonado de 60ms. Por debajo de 30 no se percibe; por encima de 80 se
         nota la espera del último. */
      .hero-copy .entra:nth-child(1) { animation-delay: 40ms; }
      .hero-copy .entra:nth-child(2) { animation-delay: 100ms; }
      .hero-copy .entra:nth-child(3) { animation-delay: 160ms; }
      .hero-copy .entra:nth-child(4) { animation-delay: 220ms; }
      .cifras.entra { animation-delay: 620ms; }

      @keyframes aparecer {
        to { opacity: 1; transform: translateY(0); }
      }

      /*
        La secuencia que explica el recorrido del pedido.

        Es la única animación larga de la página y se la ha ganado: no decora,
        cuenta cómo funciona el producto. Cada paso entra cuando el anterior ya
        se lee, con 700ms entre uno y otro — el tiempo de leer cuatro palabras.
        No se repite: en bucle cobraría batería para siempre a cambio de nada.
      */
      .paso {
        opacity: 0;
        transform: translateY(14px) scale(0.98);
        animation: aparecer-paso 520ms var(--sale) forwards;
      }
      .paso-qr { animation-delay: 320ms; }
      .paso-cocina { animation-delay: 1020ms; }
      .paso-boleta { animation-delay: 1720ms; }

      @keyframes aparecer-paso {
        to { opacity: 1; transform: translateY(0) scale(1); }
      }

      /* La línea crece acompañando a los pasos: es el hilo del recorrido. */
      .demo-linea {
        transform: scaleY(0);
        animation: crecer 1900ms var(--entra-sale) 320ms forwards;
      }
      @keyframes crecer {
        to { transform: scaleY(1); }
      }

      /* Aparición al hacer scroll. La clase la pone un IntersectionObserver. */
      .revela {
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 420ms var(--sale), transform 420ms var(--sale);
      }
      .revela.dentro { opacity: 1; transform: none; }

      /*
        Sin JavaScript no hay observador, así que nada quitaría la opacidad y la
        página quedaría en blanco. Este respaldo la deja visible: el contenido
        nunca depende de que una animación llegue a ejecutarse.
      */
      .sin-js .revela,
      .sin-js .entra,
      .sin-js .paso { opacity: 1; transform: none; animation: none; }

      /*
        Menos movimiento: una versión SUAVE, no cero.
        Antes se apagaba todo con un `if`, y como las cifras subían con un
        contador, quien pedía menos movimiento se quedaba leyendo "0" para
        siempre. Aquí se conserva el fundido —que no marea— y se quita el
        desplazamiento, que es lo que molesta.
      */
      @media (prefers-reduced-motion: reduce) {
        .entra, .paso {
          transform: none;
          animation: fundir 200ms linear forwards;
        }
        .revela { transform: none; transition: opacity 200ms linear; }
        .demo-linea { animation: none; transform: scaleY(1); }
        .btn, .bloque { transition: none; }
      }

      /*
        Fuera de la consulta de medios a proposito. Anidado dentro seguia siendo
        CSS valido, pero de este keyframes depende que la pagina llegue a verse
        para quien pide menos movimiento: si un minificador o un reordenado lo
        pierde, esas personas se quedan con la pagina en blanco y nadie se
        entera. No es sitio para correr riesgos de compatibilidad.
      */
      @keyframes fundir {
        to { opacity: 1; }
      }
    </style>

    <script is:inline>
      /*
        Todo el JavaScript de la página. Sustituye a los 116 KB de GSAP +
        ScrollTrigger que enviaba la versión anterior para hacer justo esto.

        Va en línea y sin `defer` para que la clase se aplique antes del primer
        pintado: si se aplicara después, habría un parpadeo del contenido visible
        al contenido oculto.
      */
      document.documentElement.classList.remove("sin-js");

      var nav = document.getElementById("nav");
      var alHacerScroll = function () {
        if (nav) nav.classList.toggle("posado", window.scrollY > 8);
      };
      alHacerScroll();
      addEventListener("scroll", alHacerScroll, { passive: true });

      /*
        Aparición al entrar en pantalla. Se deja de observar en cuanto ocurre:
        una sección que se desvanece al volver a subir es un efecto que nadie
        pidió y que hace la página inestable al leerla.
      */
      var elementos = document.querySelectorAll(".revela");
      if ("IntersectionObserver" in window) {
        var observador = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (entrada, i) {
              if (!entrada.isIntersecting) return;
              // 40ms de escalonado entre hermanos que entran juntos.
              entrada.target.style.transitionDelay = i * 40 + "ms";
              entrada.target.classList.add("dentro");
              observador.unobserve(entrada.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px" },
        );
        elementos.forEach(function (el) {
          observador.observe(el);
        });
      } else {
        elementos.forEach(function (el) {
          el.classList.add("dentro");
        });
      }
    </script>
  </body>
</html>
